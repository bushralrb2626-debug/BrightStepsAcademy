@model IReadOnlyList<BrightStepsAcademy.Domain.StudentRecord>
@{ Layout = "_DashboardLayout"; }
<partial name="Partials/_TeacherAssignmentPicker" />
<div class="dash-panel reveal">
    <div class="dash-panel__head"><h3>Students</h3></div>
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No students in this class section.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>Roll</th><th>Name</th><th>Code</th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr><td>@s.RollNumber</td><td>@s.FullName</td><td>@s.StudentCode</td></tr>
            }
            </tbody>
        </table>
    }
</div>
