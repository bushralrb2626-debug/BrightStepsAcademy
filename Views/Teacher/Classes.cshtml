@model IReadOnlyList<TeacherAssignmentOptionVm>
@{ Layout = "_DashboardLayout"; }
<partial name="Partials/_TeacherAssignmentPicker" />
<div class="section-head reveal"><h3>My Classes</h3></div>
<div class="grid-3 stagger">
@foreach (var a in Model)
{
    <article class="class-card card-lift accent-sky">
        <h3>@a.Label</h3>
        <p class="text-muted">@a.StudentCount students</p>
        <div class="d-flex gap-1 flex-wrap">
            <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Students" asp-route-assignmentId="@a.Id">Students</a>
            <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Diary" asp-route-assignmentId="@a.Id">Diary</a>
            <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Attendance" asp-route-assignmentId="@a.Id">Attendance</a>
        </div>
    </article>
}
</div>
