@{
    Layout = "_DashboardLayout";
    var store = (ISchoolData)ViewBag.Store;
    var profile = (DashboardProfile)ViewBag.Profile;
    var myClasses = store.Classes.Where(c => c.Teacher.Contains("Sarah")).ToList();
    if (myClasses.Count == 0) { myClasses = store.Classes.Take(3).ToList(); }
}
<div class="welcome-banner reveal">
    <h2>@profile.Greeting</h2>
    <p>@profile.Subtitle</p>
</div>

<div class="kpi-grid stagger">
    <div class="kpi-card accent-sky"><div class="kpi-label">My classes</div><strong class="counter" data-target="@myClasses.Count">0</strong></div>
    <div class="kpi-card accent-mint"><div class="kpi-label">Assignments</div><strong class="counter" data-target="@store.Assignments.Count">0</strong></div>
    <div class="kpi-card accent-orange"><div class="kpi-label">Pending reviews</div><strong class="counter" data-target="7">0</strong></div>
    <div class="kpi-card accent-pink"><div class="kpi-label">Messages</div><strong class="counter" data-target="3">0</strong></div>
</div>

<div class="section-head reveal"><h3>My Classes</h3></div>
<div class="grid-3 stagger mb-2">
    @foreach (var c in myClasses)
    {
        <article class="class-card card-lift accent-sky">
            <h3>@c.Name</h3>
            <p class="text-muted">@c.Room · @c.Students students</p>
            <p>@c.Schedule</p>
        </article>
    }
</div>

<div class="grid-2">
    <div class="dash-panel reveal">
        <div class="dash-panel__head"><h3>Schedule timeline</h3></div>
        <div class="timeline">
            @foreach (var t in store.TodaySchedule)
            {
                <div class="timeline-item accent-@t.Accent">
                    <div class="time">@t.Time</div>
                    <div><strong>@t.Title</strong><span>@t.Meta</span></div>
                </div>
            }
        </div>
    </div>
    <div class="dash-panel reveal">
        <div class="dash-panel__head"><h3>Assignment overview</h3></div>
        <div class="info-row"><span>Submitted</span><strong>68%</strong></div>
        <div class="progress-bsa grass mb-2"><span style="width:68%"></span></div>
        <div class="info-row"><span>Pending</span><strong>18%</strong></div>
        <div class="progress-bsa sun mb-2"><span style="width:18%"></span></div>
        <div class="info-row"><span>Late</span><strong>14%</strong></div>
        <div class="progress-bsa coral"><span style="width:14%"></span></div>
    </div>
</div>

<div class="dash-panel reveal">
    <div class="dash-panel__head"><h3>Recent students</h3></div>
    <div class="grid-4">
        @foreach (var s in store.Students.Where(x => x.ClassName.Contains("5") || x.ClassName.Contains("4") || x.ClassName.Contains("3")).Take(8))
        {
            <div class="person-card">
                <img src="@s.Photo" alt="" />
                <strong>@s.Name</strong>
                <p class="text-muted mb-0">@s.ClassName-@s.Section</p>
            </div>
        }
    </div>
</div>
