@model TeacherDashboardVm
@{
    Layout = "_DashboardLayout";
}
@if (ViewBag.MustChangePassword == true)
{
    <div class="alert-bsa alert-bsa-warn mb-2">Please <a asp-action="Security">change your password</a> to continue.</div>
}
<div class="welcome-banner reveal">
    <h2>Teacher Dashboard</h2>
    <p>Manage diary, attendance, marks, announcements, and course material for your assigned classes.</p>
</div>
<div class="kpi-grid stagger mb-2">
    <div class="kpi-card accent-sky"><div class="kpi-label">Assignments</div><strong>@Model.AssignmentCount</strong></div>
    <div class="kpi-card accent-mint"><div class="kpi-label">Students</div><strong>@Model.StudentCount</strong></div>
    <div class="kpi-card accent-orange"><div class="kpi-label">Draft diary</div><strong>@Model.DraftDiaryCount</strong></div>
    <div class="kpi-card accent-pink"><div class="kpi-label">Published diary</div><strong>@Model.PublishedDiaryCount</strong></div>
</div>
@if (Model.Assignments.Count == 0)
{
    <partial name="Partials/_TeacherSetupRequired" />
}
else
{
    <div class="grid-3 stagger">
        @foreach (var a in Model.Assignments)
        {
            <article class="class-card card-lift accent-sky">
                <h3>@a.Label</h3>
                <p class="text-muted mb-1">@a.StudentCount students</p>
                <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Diary" asp-route-assignmentId="@a.Id">Open diary</a>
            </article>
        }
    </div>
}
