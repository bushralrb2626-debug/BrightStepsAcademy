@model IReadOnlyList<DiaryEntryListItemVm>
@{ Layout = "_DashboardLayout"; var assignmentId = ViewBag.SelectedAssignmentId as Guid?; }
<partial name="Partials/_TeacherAssignmentPicker" />
<div class="dash-panel reveal">
    <div class="dash-panel__head d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Daily Diary</h3>
        @if (assignmentId.HasValue)
        {
            <a class="btn-bsa btn-bsa-sm btn-bsa-primary" asp-action="CreateDiary" asp-route-assignmentId="@assignmentId">New entry</a>
        }
    </div>
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No diary entries yet.</p>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="info-row align-items-start">
                <div>
                    <strong>@item.Title</strong>
                    <div class="text-muted small">@item.ContentDate.ToString("MMM d, yyyy") · @item.Topic</div>
                </div>
                <div class="text-end">
                    <span class="badge-soft">@item.Status</span>
                    @if (item.Status == BrightStepsAcademy.Domain.PublishStatus.Draft && assignmentId.HasValue)
                    {
                        <form asp-action="PublishDiary" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="assignmentId" value="@assignmentId" />
                            <button type="submit" class="btn-bsa btn-bsa-sm btn-bsa-soft">Publish</button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</div>
