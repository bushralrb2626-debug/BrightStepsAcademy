@model ClassAssignmentFormVm
@{ Layout = "_DashboardLayout"; }
<div class="dash-panel reveal">
    <h3>New assignment</h3>
    <form asp-action="CreateClassAssignment" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AssignmentId" />
        <div class="mb-2"><label>Title</label><input asp-for="Title" class="form-control" required /></div>
        <div class="mb-2"><label>Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
        <div class="grid-2 mb-2">
            <div><label>Assigned date</label><input asp-for="ContentDate" type="date" class="form-control" /></div>
            <div><label>Due date</label><input asp-for="DueDate" type="date" class="form-control" /></div>
        </div>
        <div class="mb-2"><label>Total marks (optional)</label><input asp-for="TotalMarks" type="number" step="0.01" class="form-control" /></div>
        <div class="mb-2"><label class="form-check"><input asp-for="AllowSubmission" class="form-check-input" /> Allow student submission</label></div>
        <div class="mb-2"><label>Attachment</label><input asp-for="Attachment" type="file" class="form-control" /></div>
        <div class="mb-2"><label>Status</label><select asp-for="Status" class="form-select"><option value="Draft">Draft</option><option value="Published">Publish</option></select></div>
        <button type="submit" class="btn-bsa btn-bsa-primary">Save</button>
    </form>
</div>
