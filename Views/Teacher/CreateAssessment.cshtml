@model AssessmentFormVm
@{
    Layout = "_DashboardLayout";
}
<partial name="Partials/_TeacherAssignmentPicker" />
<div class="dash-panel reveal">
    <h3>New assessment &amp; marks</h3>
    <p class="text-muted">Add mark columns by assessment type, enter important info, then fill marks for the whole class.</p>
    <form asp-action="CreateAssessment" method="post" id="assessmentForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AssignmentId" />
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <partial name="Partials/_AssessmentMarksGrid" model="new AssessmentMarksGridVm {
            ImportantInfo = Model.ImportantInfo,
            Columns = Model.Columns,
            Marks = Model.Marks
        }" />

        <button type="submit" class="btn-bsa btn-bsa-primary">Save assessment &amp; marks</button>
        <a asp-action="GradeBook" asp-route-assignmentId="@Model.AssignmentId" class="btn-bsa btn-bsa-soft">Cancel</a>
    </form>
</div>
