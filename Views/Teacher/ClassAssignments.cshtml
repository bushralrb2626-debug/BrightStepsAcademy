@model IReadOnlyList<ClassAssignmentListItemVm>
@{ Layout = "_DashboardLayout"; var assignmentId = ViewBag.SelectedAssignmentId as Guid?; }
<partial name="Partials/_TeacherAssignmentPicker" />
<div class="dash-panel reveal">
    <div class="dash-panel__head d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Student Assignments</h3>
        @if (assignmentId.HasValue) { <a class="btn-bsa btn-bsa-sm btn-bsa-primary" asp-action="CreateClassAssignment" asp-route-assignmentId="@assignmentId">New</a> }
    </div>
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No assignments yet.</p>
    }
    @foreach (var item in Model)
    {
        <article class="mb-2 pb-2 border-bottom">
            <div class="d-flex justify-content-between"><strong>@item.Title</strong><span class="badge-soft">@item.Status</span></div>
            <div class="text-muted small mb-1">Assigned @item.ContentDate.ToString("MMM d") · Due @item.DueDate.ToString("MMM d")</div>
            @if (item.Status == BrightStepsAcademy.Domain.PublishStatus.Draft && assignmentId.HasValue)
            {
                <form asp-action="PublishClassAssignment" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.Id" />
                    <input type="hidden" name="assignmentId" value="@assignmentId" />
                    <button type="submit" class="btn-bsa btn-bsa-sm btn-bsa-soft">Publish</button>
                </form>
            }
        </article>
    }
</div>
