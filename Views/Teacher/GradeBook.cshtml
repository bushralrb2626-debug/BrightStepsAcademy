@model IReadOnlyList<AssessmentListItemVm>
@{ Layout = "_DashboardLayout"; var assignmentId = ViewBag.SelectedAssignmentId as Guid?; }
<partial name="Partials/_TeacherAssignmentPicker" />
<div class="dash-panel reveal">
    <div class="dash-panel__head d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Grade Book</h3>
        @if (assignmentId.HasValue)
        {
            <a class="btn-bsa btn-bsa-sm btn-bsa-primary" asp-action="CreateAssessment" asp-route-assignmentId="@assignmentId">New assessment</a>
        }
    </div>
    @foreach (var item in Model)
    {
        <div class="info-row">
            <div>
                <strong>@item.Name</strong>
                <div class="text-muted small">@item.AssessmentDate.ToString("MMM d") · @item.AssessmentType · @item.TotalMarks marks</div>
            </div>
            <div class="text-end">
                <span class="badge-soft">@item.Status</span>
                @if (assignmentId.HasValue)
                {
                    <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Marks" asp-route-id="@item.Id" asp-route-assignmentId="@assignmentId">Marks</a>
                    @if (item.Status == BrightStepsAcademy.Domain.PublishStatus.Draft)
                    {
                        <form asp-action="PublishAssessment" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="assignmentId" value="@assignmentId" />
                            <button type="submit" class="btn-bsa btn-bsa-sm btn-bsa-soft">Publish</button>
                        </form>
                    }
                }
            </div>
        </div>
    }
</div>
