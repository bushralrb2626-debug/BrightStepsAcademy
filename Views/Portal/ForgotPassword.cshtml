@{
    var email = (string?)ViewBag.Email ?? "";
    var message = ViewBag.Message as string;
}
<section class="login-page">
    <div class="login-page__visual">
        <div class="blob accent-yellow"></div>
        <div class="blob accent-mint"></div>
        <img src="@Images.Login" alt="Bright classroom at BrightSteps Academy" />
        <div class="login-page__quote reveal">
            <partial name="Partials/_Logo" />
            <h1>Forgot password</h1>
            <p>Password resets are handled by your school administrator for v1.</p>
        </div>
    </div>
    <div class="login-page__form reveal">
        <p class="eyebrow">Account help</p>
        <h2>Reset Password</h2>
        <p class="login-page__hint">Enter your email and we will show you how to get help.</p>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="login-demo-accounts" style="border-left-color:#21A65A;background:#E8F8EF;">
                @message
            </div>
        }

        <form class="form-bsa" method="post" asp-controller="Portal" asp-action="ForgotPassword">
            <label>
                Email
                <input type="email" name="email" required placeholder="you@brightsteps.academy" value="@email" autocomplete="username" />
            </label>
            <button type="submit" class="btn-bsa btn-bsa-primary">Continue</button>
            <a class="btn-bsa btn-bsa-ghost" asp-controller="Portal" asp-action="Login">Back to login</a>
        </form>
    </div>
</section>
