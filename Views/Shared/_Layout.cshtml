<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Home") · @(ViewData["SchoolName"] ?? "Scuola Materna")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bridge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vibrant.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fancy.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/campus-bot.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="site-body">
    <partial name="Partials/_PublicNav" />
    <main>
        @RenderBody()
    </main>
    <partial name="Partials/_PublicFooter" />
    <partial name="Partials/_ToastHost" />
    <partial name="Partials/_ModalShell" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <partial name="Partials/_CampusUser" />
    <script src="~/js/campus-bot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
