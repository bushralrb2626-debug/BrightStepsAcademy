@{
    var store = ViewBag.Store as ISchoolData;
    var school = store?.Schools.FirstOrDefault();
}
<footer class="footer-bsa">
    <svg class="footer-illus" width="120" height="90" viewBox="0 0 120 90" aria-hidden="true">
        <rect x="20" y="30" width="80" height="50" rx="6" fill="#1565D8"/>
        <polygon points="20,30 60,8 100,30" fill="#FF7A1A"/>
        <rect x="50" y="52" width="20" height="28" fill="#F5C518"/>
        <rect x="32" y="42" width="14" height="14" fill="#fff"/>
        <rect x="74" y="42" width="14" height="14" fill="#fff"/>
    </svg>
    <div class="footer-bsa__inner">
        <div class="footer-bsa__brand">
            <partial name="Partials/_Logo" />
            <p>A joyful place where children learn, explore, and grow — every single day.</p>
            <div class="footer-social" aria-label="Link social">
                <a href="#" aria-label="Facebook">f</a>
                <a href="#" aria-label="Instagram">ig</a>
                <a href="#" aria-label="YouTube">▶</a>
            </div>
        </div>
        <div class="footer-bsa__col">
            <h4>Explore</h4>
            <a asp-controller="Home" asp-action="About">About</a>
            <a asp-controller="Home" asp-action="Programs">Programs</a>
            <a asp-controller="Home" asp-action="Facilities">Facilities</a>
            <a asp-controller="Home" asp-action="Teachers">Teachers</a>
        </div>
        <div class="footer-bsa__col">
            <h4>School Life</h4>
            <a asp-controller="Home" asp-action="Activities">Activities</a>
            <a asp-controller="Home" asp-action="Events">Events</a>
            <a asp-controller="Home" asp-action="Gallery">Gallery</a>
            <a asp-controller="Home" asp-action="Contact">Contact</a>
        </div>
        <div class="footer-bsa__col">
            <h4>Visit</h4>
            <p>@(school?.Address ?? "42 Maple Grove, Riverside")</p>
            <p>@(school?.Phone ?? "+1 (555) 214-8800")</p>
            <p>@(school?.Email ?? "hello@brightsteps.academy")</p>
            <a class="btn-bsa btn-bsa-soft" asp-controller="Portal" asp-action="Login">🔐 Login</a>
        </div>
    </div>
    <div class="footer-bsa__bar">
        <span>&copy; @DateTime.Now.Year @(ViewData["SchoolName"] ?? school?.Name ?? "Scuola Materna") · @(ViewData["Tagline"] ?? "Learn. Explore. Grow.")</span>
        <a asp-controller="Home" asp-action="Contact">Get in touch</a>
    </div>
</footer>
