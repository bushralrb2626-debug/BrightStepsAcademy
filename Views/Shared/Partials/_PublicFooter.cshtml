@{
    var store = ViewBag.Store as ISchoolData;
    var school = store?.Schools.FirstOrDefault();
}
<footer class="footer-bsa">
    <svg class="footer-illus" width="120" height="90" viewBox="0 0 120 90" aria-hidden="true">
        <rect x="20" y="30" width="80" height="50" rx="6" fill="#1565D8"/>
        <polygon points="20,30 60,8 100,30" fill="#FF7A1A"/>
        <rect x="50" y="52" width="20" height="28" fill="#F5C518"/>
        <rect x="32" y="42" width="14" height="14" fill="#fff"/>
        <rect x="74" y="42" width="14" height="14" fill="#fff"/>
    </svg>
    <div class="footer-bsa__inner">
        <div class="footer-bsa__brand">
            <partial name="Partials/_Logo" />
            <p>Un luogo gioioso dove i bambini imparano, esplorano e crescono — ogni giorno.</p>
            <div class="footer-social" aria-label="Link social">
                <a href="#" aria-label="Facebook">f</a>
                <a href="#" aria-label="Instagram">ig</a>
                <a href="#" aria-label="YouTube">▶</a>
            </div>
        </div>
        <div class="footer-bsa__col">
            <h4>Esplora</h4>
            <a asp-controller="Home" asp-action="About">Chi siamo</a>
            <a asp-controller="Home" asp-action="Programs">Programmi</a>
            <a asp-controller="Home" asp-action="Facilities">Strutture</a>
            <a asp-controller="Home" asp-action="Teachers">Insegnanti</a>
        </div>
        <div class="footer-bsa__col">
            <h4>Vita scolastica</h4>
            <a asp-controller="Home" asp-action="Activities">Attività</a>
            <a asp-controller="Home" asp-action="Events">Eventi</a>
            <a asp-controller="Home" asp-action="Gallery">Galleria</a>
            <a asp-controller="Home" asp-action="Contact">Contatti</a>
        </div>
        <div class="footer-bsa__col">
            <h4>Visita</h4>
            <p>@(school?.Address ?? "42 Maple Grove, Riverside")</p>
            <p>@(school?.Phone ?? "+1 (555) 214-8800")</p>
            <p>@(school?.Email ?? "hello@brightsteps.academy")</p>
            <a class="btn-bsa btn-bsa-soft" asp-controller="Portal" asp-action="Login">🔐 Accedi</a>
        </div>
    </div>
    <div class="footer-bsa__bar">
        <span>&copy; @DateTime.Now.Year @(ViewData["SchoolName"] ?? school?.Name ?? "Scuola Materna") · @(ViewData["Tagline"] ?? "Impara. Esplora. Cresci.")</span>
        <a asp-controller="Home" asp-action="Contact">Scrivici</a>
    </div>
</footer>
