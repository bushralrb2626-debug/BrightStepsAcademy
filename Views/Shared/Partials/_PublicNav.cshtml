@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    string Active(string action) =>
        string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(current, action, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
}
<header class="site-nav">
    <div class="site-nav__inner">
        <partial name="Partials/_Logo" />
        <button class="site-nav__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Apri menu">
            <span></span><span></span><span></span>
        </button>
        <nav class="collapse site-nav__menu" id="publicNav">
            <a class="site-nav__link @Active("Index")" asp-controller="Home" asp-action="Index">Home</a>
            <a class="site-nav__link @Active("About")" asp-controller="Home" asp-action="About">Chi siamo</a>
            <a class="site-nav__link @Active("Programs")" asp-controller="Home" asp-action="Programs">Programmi</a>
            <a class="site-nav__link @Active("Facilities")" asp-controller="Home" asp-action="Facilities">Strutture</a>
            <a class="site-nav__link @Active("Teachers")" asp-controller="Home" asp-action="Teachers">Insegnanti</a>
            <a class="site-nav__link @Active("Activities")" asp-controller="Home" asp-action="Activities">Attività</a>
            <a class="site-nav__link @Active("Events")" asp-controller="Home" asp-action="Events">Eventi</a>
            <a class="site-nav__link @Active("Gallery")" asp-controller="Home" asp-action="Gallery">Galleria</a>
            <a class="site-nav__link @Active("Contact")" asp-controller="Home" asp-action="Contact">Contatti</a>
            <a class="btn-bsa btn-bsa-primary site-nav__cta" asp-controller="Portal" asp-action="Login">🔐 Accedi <span class="cta-arrow" aria-hidden="true">→</span></a>
            <div class="lang-switch" id="langSwitch" role="group" aria-label="Lingua">
                <button type="button" class="lang-switch__btn" data-set-lang="en" aria-pressed="false">EN</button>
                <button type="button" class="lang-switch__btn" data-set-lang="it" aria-pressed="false">IT</button>
            </div>
        </nav>
    </div>
</header>
