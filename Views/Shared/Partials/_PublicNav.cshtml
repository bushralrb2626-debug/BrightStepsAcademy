@{
    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    string Active(string action) =>
        string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(current, action, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
}
<header class="site-nav">
    <div class="site-nav__inner">
        <partial name="Partials/_Logo" />
        <button class="site-nav__toggle" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation">
            <span></span><span></span><span></span>
        </button>
        <nav class="collapse site-nav__menu" id="publicNav">
            <a class="site-nav__link @Active("Index")" asp-controller="Home" asp-action="Index">Home</a>
            <a class="site-nav__link @Active("About")" asp-controller="Home" asp-action="About">About</a>
            <a class="site-nav__link @Active("Programs")" asp-controller="Home" asp-action="Programs">Programs</a>
            <a class="site-nav__link @Active("Facilities")" asp-controller="Home" asp-action="Facilities">Facilities</a>
            <a class="site-nav__link @Active("Teachers")" asp-controller="Home" asp-action="Teachers">Teachers</a>
            <a class="site-nav__link @Active("Activities")" asp-controller="Home" asp-action="Activities">Activities</a>
            <a class="site-nav__link @Active("Events")" asp-controller="Home" asp-action="Events">Events</a>
            <a class="site-nav__link @Active("Gallery")" asp-controller="Home" asp-action="Gallery">Gallery</a>
            <a class="site-nav__link @Active("Contact")" asp-controller="Home" asp-action="Contact">Contact</a>
            <a class="btn-bsa btn-bsa-primary site-nav__cta" asp-controller="Portal" asp-action="Login">🔐 Login <span class="cta-arrow" aria-hidden="true">→</span></a>
        </nav>
    </div>
</header>
