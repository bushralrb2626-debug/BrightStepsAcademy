@{
    Layout = "_DashboardLayout";
}
<div class="section-head reveal mb-2">
    <h2>Performance</h2>
    <p>Campus learning trends for leadership review.</p>
</div>

<div class="grid-2 stagger">
    <div class="chart-card accent-sky"><h3>Subject averages</h3><div class="chart-wrap"><canvas data-chart-type="bar" data-chart='{"labels":["Math","English","Science","Computer","Urdu"],"data":[92,88,95,90,84]}'></canvas></div></div>
    <div class="chart-card accent-mint"><h3>Term comparison</h3><div class="chart-wrap"><canvas data-chart-type="line" data-chart='{"labels":["T1","T2","T3"],"datasets":[{"label":"2025","data":[84,86,88]},{"label":"2026","data":[87,90,92]}]}'></canvas></div></div>
    <div class="chart-card accent-purple"><h3>Grade bands</h3><div class="chart-wrap"><canvas data-chart-type="doughnut" data-chart='{"labels":["A+","A","B+","B"],"data":[22,38,28,12]}'></canvas></div></div>
    <div class="chart-card accent-orange"><h3>Teacher impact</h3><div class="chart-wrap"><canvas data-chart-type="bar" data-chart='{"labels":["Sarah","David","Amina","Michael"],"data":[94,91,93,89]}'></canvas></div></div>
</div>
