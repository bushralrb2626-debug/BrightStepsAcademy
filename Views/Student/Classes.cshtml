@{
    Layout = "_DashboardLayout";
    var store = (ISchoolData)ViewBag.Store;
    var accents = new[] { "sky", "mint", "orange", "pink", "purple", "yellow" };
    var i = 0;
}
<div class="playful">
    <div class="section-head reveal mb-2">
        <h2>My Classes 📚</h2>
        <p>Every subject gets a splash of colour.</p>
    </div>
    <div class="grid-3 stagger">
        @foreach (var s in store.Subjects)
        {
            var accent = accents[i++ % accents.Length];
            <article class="class-card card-lift accent-@accent quick-tile" style="border-style:solid;">
                <h3>@s</h3>
                <p class="text-muted">Grade 5-A · with your teachers</p>
                <span class="badge-soft">Let's go!</span>
            </article>
        }
    </div>
</div>
