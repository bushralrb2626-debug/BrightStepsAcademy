@model Teacher
@{
    var store = (ISchoolData)ViewBag.Store;
}
<section class="page-hero section">
    <div class="blob accent-coral"></div>
    <div class="profile-hero reveal">
        <img class="profile-hero__photo" src="@Model.Photo" alt="@Model.Name" />
        <div>
            <p class="eyebrow">Teacher profile</p>
            <h1>@Model.Name</h1>
            <span class="badge-soft accent-sky">@Model.Subject</span>
            <p>@Model.ExperienceYears years · @Model.Classes</p>
        </div>
    </div>
</section>

<section class="section">
    <div class="detail-grid">
        <article class="detail-card card-lift reveal">
            <h2>About @Model.Name.Split(' ').First()</h2>
            <p>@Model.Bio</p>
            <ul class="detail-meta">
                <li><strong>Teacher ID</strong> @Model.TeacherId</li>
                <li><strong>Email</strong> @Model.Email</li>
                <li><strong>Phone</strong> @Model.Phone</li>
                <li><strong>Status</strong> @Model.Status</li>
            </ul>
            <a class="btn-bsa btn-bsa-soft" asp-controller="Home" asp-action="Teachers">Back to teachers</a>
        </article>
        <aside class="detail-aside reveal">
            <h3>More teachers</h3>
            <div class="teachers-grid teachers-grid--mini">
                @foreach (var t in store.Teachers.Where(x => x.Id != Model.Id).Take(4))
                {
                    <a class="teacher-card card-lift" asp-controller="Home" asp-action="TeacherProfile" asp-route-id="@t.Id">
                        <img src="@t.Photo" alt="@t.Name" />
                        <div class="teacher-card__body">
                            <h4>@t.Name</h4>
                            <span class="badge-soft">@t.Subject</span>
                        </div>
                    </a>
                }
            </div>
        </aside>
    </div>
</section>
