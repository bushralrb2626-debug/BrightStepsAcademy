@{
    var store = (ISchoolData)ViewBag.Store;
}
<section class="page-hero section">
    <div class="blob accent-sky"></div>
    <div class="section-head reveal">
        <p class="eyebrow">Programs</p>
        <h1>Pathways for every learner</h1>
        <p>Find the right mix of academics, arts, sports, and discovery.</p>
    </div>
</section>

<section class="section">
    <div class="card-grid programs-grid">
        @foreach (var p in store.Programs)
        {
            <a class="program-card card-lift reveal accent-@p.Accent" asp-controller="Home" asp-action="Program" asp-route-name="@p.Title">
                <div class="program-card__media">
                    <img src="@p.Image" alt="@p.Title" />
                </div>
                <div class="program-card__body">
                    @{ ViewData["Icon"] = p.Icon; }
                    <partial name="Partials/_Icons" />
                    <h3>@p.Title</h3>
                    <p>@p.Description</p>
                    <span class="btn-bsa btn-bsa-soft">Learn more</span>
                </div>
            </a>
        }
    </div>
</section>
