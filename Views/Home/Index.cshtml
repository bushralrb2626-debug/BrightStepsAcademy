@* ===== CONTACT ===== *@
<section class="band contact-fancy" id="contact" style="background:#FFF9F0">
    <div class="band__inner">
        <div class="section-head fancy reveal">
            <p class="eyebrow">Vieni a trovarci</p>
            <h2>Vieni a salutarci</h2>
            <p>Ci piace conoscere nuove famiglie su Maple Grove.</p>
        </div>
        <div class="contact-grid">
            <form id="contactForm" class="form-bsa card-lift reveal" method="post" action="#">
                <label>Nome <input type="text" name="name" required placeholder="Il tuo nome" /></label>
                <label>Email <input type="email" name="email" required placeholder="you@email.com" /></label>
                <label>Oggetto <input type="text" name="subject" required placeholder="Iscrizioni, visit, or question" /></label>
                <label>Messaggio <textarea name="message" rows="5" required placeholder="Come possiamo aiutarti?"></textarea></label>
                <button type="submit" class="btn-bsa btn-bsa-primary">Invia messaggio <span class="btn-ico">✈️</span></button>
            </form>
            <div class="contact-side reveal">
                <div class="contact-card" style="border:4px solid #FF7A1A;border-radius:1.4rem">
                    <h3>@(site?.Name ?? displayName)</h3>
                    <p><strong>Indirizzo:</strong> @(site?.Contact?.Address ?? "42 Maple Grove Avenue, Riverside")</p>
                    <p><strong>Telefono:</strong> @(site?.Contact?.Phone ?? "+1 (555) 214-8800")</p>
                    <p><strong>Email:</strong> @(site?.Contact?.Email ?? "hello@brightfuture.academy")</p>
                    <p><strong>Orari di ufficio:</strong> @(site?.Contact?.OfficeHours ?? "Lun–Ven · 8:00 – 16:00")</p>
                </div>
                <div class="map-placeholder" role="img" aria-label="Segnaposto mappa">
                    <span>📍 Segnaposto mappa</span>
                    <small>@(site?.Contact?.Address ?? "42 Maple Grove, Riverside")</small>
                </div>
            </div>
        </div>
    </div>
</section>
