@* ===== CONTACT ===== *@
<section class="band contact-fancy" id="contact" style="background:#FFF9F0">
    <div class="band__inner">
        <div class="section-head fancy reveal">
            <p class="eyebrow">Visit Us</p>
            <h2>Come say hello</h2>
            <p>We love meeting new families on Maple Grove.</p>
        </div>
        <div class="contact-grid">
            <form id="contactForm" class="form-bsa card-lift reveal" method="post" action="#">
                <label>Name <input type="text" name="name" required placeholder="Your name" /></label>
                <label>Email <input type="email" name="email" required placeholder="you@email.com" /></label>
                <label>Subject <input type="text" name="subject" required placeholder="Enrollments, visit, or question" /></label>
                <label>Message <textarea name="message" rows="5" required placeholder="How can we help?"></textarea></label>
                <button type="submit" class="btn-bsa btn-bsa-primary">Send message <span class="btn-ico">✈️</span></button>
            </form>
            <div class="contact-side reveal">
                <div class="contact-card" style="border:4px solid #FF7A1A;border-radius:1.4rem">
                    <h3>@(site?.Name ?? displayName)</h3>
                    <p><strong>Address:</strong> @(site?.Contact?.Address ?? "42 Maple Grove Avenue, Riverside")</p>
                    <p><strong>Phone:</strong> @(site?.Contact?.Phone ?? "+1 (555) 214-8800")</p>
                    <p><strong>Email:</strong> @(site?.Contact?.Email ?? "hello@brightfuture.academy")</p>
                    <p><strong>Office hours:</strong> @(site?.Contact?.OfficeHours ?? "Mon–Fri · 8:00 AM – 4:00 PM")</p>
                </div>
                <div class="map-placeholder" role="img" aria-label="Map placeholder">
                    <span>📍 Map placeholder</span>
                    <small>@(site?.Contact?.Address ?? "42 Maple Grove, Riverside")</small>
                </div>
            </div>
        </div>
    </div>
</section>
