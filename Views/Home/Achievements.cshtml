<section class="page-hero section">
    <div class="blob accent-royal"></div>
    <div class="section-head reveal">
        <p class="eyebrow">Achievements</p>
        <h1>Proud milestones</h1>
        <p>Celebrating growth, awards, and community spirit.</p>
    </div>
</section>

<section class="section achievements-section">
    <div class="achievements-grid">
        <div class="stat-chip accent-royal reveal">
            <strong class="counter" data-target="98" data-count="98">0</strong>
            <span>Parent satisfaction %</span>
        </div>
        <div class="stat-chip accent-mint reveal">
            <strong class="counter" data-target="120" data-count="120">0</strong>
            <span>Awards &amp; medals</span>
        </div>
        <div class="stat-chip accent-pink reveal">
            <strong class="counter" data-target="36" data-count="36">0</strong>
            <span>Clubs &amp; houses</span>
        </div>
        <div class="stat-chip accent-yellow reveal">
            <strong class="counter" data-target="15" data-count="15">0</strong>
            <span>Years of excellence</span>
        </div>
        <div class="stat-chip accent-sky reveal">
            <strong class="counter" data-target="48" data-count="48">0</strong>
            <span>Science fair projects</span>
        </div>
        <div class="stat-chip accent-coral reveal">
            <strong class="counter" data-target="12" data-count="12">0</strong>
            <span>Inter-school trophies</span>
        </div>
    </div>
    <div class="achievement-spotlight card-lift reveal">
        <img src="@Images.Trophy" alt="Trophy celebration" />
        <div>
            <h2>Excellence with kindness</h2>
            <p>Our students shine in academics, arts, and athletics — and we celebrate effort as loudly as medals. Every year ends with assemblies full of cheers, certificates, and proud families.</p>
            <a class="btn-bsa btn-bsa-primary" asp-controller="Home" asp-action="Gallery">See the gallery</a>
        </div>
    </div>
</section>
