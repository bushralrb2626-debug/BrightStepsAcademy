@model IReadOnlyList<GuardianChildVm>
@{
    Layout = "_DashboardLayout";
}
<div class="section-head reveal mb-2">
    <h2>@(Model.Count == 1 ? "My Child" : "My Children")</h2>
    <p>Students linked to your guardian account.</p>
</div>

@if (Model.Count == 0)
{
    <div class="dash-panel reveal"><p>No linked students found.</p></div>
}
else
{
    <div class="grid-2 stagger">
        @foreach (var child in Model)
        {
            <article class="info-card card-lift">
                <div class="flex-between" style="align-items:flex-start;">
                    <div>
                        <h3 class="mb-0">@child.FullName</h3>
                        <p class="text-muted mb-0">@child.StudentCode</p>
                    </div>
                    <span class="badge-soft badge-present">@child.Relationship</span>
                </div>
                <div class="info-row mt-2"><span>Class</span><strong>@child.ClassDisplay</strong></div>
                <div class="quick-actions mt-1">
                    <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="ReportCard" asp-route-studentId="@child.Id">Report Card</a>
                    <a class="btn-bsa btn-bsa-sm btn-bsa-ghost" asp-action="Marks" asp-route-studentId="@child.Id">Marks</a>
                </div>
            </article>
        }
    </div>
}
