@model IReadOnlyList<GuardianChildVm>
@{
    Layout = "_DashboardLayout";
    var profile = (DashboardProfile)ViewBag.Profile;
}
@if (ViewBag.MustChangePassword == true)
{
    <div class="alert-bsa alert-bsa-warn mb-2">
        Please <a asp-action="ChangePassword">change your password</a> to continue using the guardian portal.
    </div>
}
<div class="welcome-banner reveal">
    <h2>@profile.Greeting</h2>
    <p>Welcome to your guardian portal. View published diary, attendance, marks, announcements, and materials for your linked @(Model.Count == 1 ? "child" : "children").</p>
</div>

@if (Model.Count == 0)
{
    <div class="dash-panel reveal">
        <p>No students are linked to your guardian account yet. Contact your school administrator.</p>
    </div>
}
else
{
    <div class="grid-2 stagger mb-2">
        @foreach (var child in Model)
        {
            <article class="person-card card-lift accent-sky" style="text-align:left;">
                <h3 class="mb-0">@child.FullName</h3>
                <p class="text-muted mb-1">@child.ClassDisplay</p>
                <span class="badge-soft">@child.Relationship · @child.StudentCode</span>
                <div class="d-flex gap-1 flex-wrap mt-2">
                    <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Diary" asp-route-studentId="@child.Id">Diary</a>
                    <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Attendance" asp-route-studentId="@child.Id">Attendance</a>
                    <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Marks" asp-route-studentId="@child.Id">Marks</a>
                </div>
            </article>
        }
    </div>
}

<div class="grid-2">
    <div class="dash-panel reveal">
        <div class="dash-panel__head"><h3>Quick links</h3></div>
        <a class="btn-bsa btn-bsa-sm btn-bsa-soft me-1" asp-action="Announcements">Announcements</a>
        <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="Materials">Course material</a>
    </div>
    <div class="dash-panel reveal">
        <div class="dash-panel__head"><h3>Account</h3></div>
        <a class="btn-bsa btn-bsa-sm btn-bsa-soft" asp-action="ChangePassword">Change password</a>
    </div>
</div>
