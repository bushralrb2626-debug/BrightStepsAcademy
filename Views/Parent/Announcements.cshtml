@model IReadOnlyList<ParentAnnouncementItemVm>
@{
    Layout = "_DashboardLayout";
    var scope = (ParentStudentScopeVm?)ViewBag.Scope;
}
<div class="section-head reveal mb-2">
    <h2>Announcements</h2>
    @if (scope is not null)
    {
        <p>@scope.FullName · @scope.ClassDisplay</p>
    }
</div>

@if (scope is not null)
{
    <partial name="Partials/_ParentChildPicker" model="scope" />
}

@if (Model.Count == 0)
{
    <div class="dash-panel reveal"><p class="text-muted mb-0">No announcements yet.</p></div>
}
else
{
    <div class="dash-panel reveal">
        @foreach (var item in Model)
        {
            <article class="mb-3 pb-3 border-bottom">
                <h4>@item.Title</h4>
                <p class="text-muted">@item.ContentDate.ToString("MMM d, yyyy") · @item.SubjectName</p>
                <p>@item.Message</p>
            </article>
        }
    </div>
}
