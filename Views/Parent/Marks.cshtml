@model IReadOnlyList<ParentMarkItemVm>
@{
    Layout = "_DashboardLayout";
    var scope = (ParentStudentScopeVm?)ViewBag.Scope;
}
<div class="section-head reveal mb-2">
    <h2>Marks</h2>
    @if (scope is not null)
    {
        <p>@scope.FullName · @scope.ClassDisplay</p>
    }
</div>

@if (scope is not null)
{
    <partial name="Partials/_ParentChildPicker" model="scope" />
}

@if (Model.Count == 0)
{
    <div class="dash-panel reveal"><p class="text-muted mb-0">No published marks yet.</p></div>
}
else
{
    <div class="dash-panel reveal">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Assessment</th><th>Subject</th><th>Date</th><th>Score</th><th>Grade</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.AssessmentName</td>
                        <td>@item.SubjectName</td>
                        <td>@item.AssessmentDate.ToString("MMM d, yyyy")</td>
                        <td>@item.ObtainedMarks / @item.TotalMarks</td>
                        <td>@(item.GradeLabel ?? (item.Percentage.HasValue ? $"{item.Percentage:0.#}%" : "—"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
