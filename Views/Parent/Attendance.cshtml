@model IReadOnlyList<ParentAttendanceItemVm>
@{
    Layout = "_DashboardLayout";
    var scope = (ParentStudentScopeVm?)ViewBag.Scope;
}
<div class="section-head reveal mb-2">
    <h2>Attendance</h2>
    @if (scope is not null)
    {
        <p>@scope.FullName · @scope.ClassDisplay</p>
    }
</div>

@if (scope is not null)
{
    <partial name="Partials/_ParentChildPicker" model="scope" />
}

@if (Model.Count == 0)
{
    <div class="dash-panel reveal"><p class="text-muted mb-0">No attendance records yet.</p></div>
}
else
{
    <div class="dash-panel reveal">
        @foreach (var row in Model)
        {
            <div class="info-row">
                <div>
                    <strong>@row.SessionDate.ToString("MMM d, yyyy")</strong>
                    <div class="text-muted small">@row.SubjectName @(row.PeriodLabel is not null ? $"· {row.PeriodLabel}" : "")</div>
                </div>
                <span class="badge-soft">@row.Status</span>
            </div>
        }
    </div>
}
