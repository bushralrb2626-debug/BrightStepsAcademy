@model IReadOnlyList<ParentDiaryItemVm>
@{
    Layout = "_DashboardLayout";
    var scope = (ParentStudentScopeVm?)ViewBag.Scope;
}
<div class="section-head reveal mb-2">
    <h2>Daily Diary</h2>
    @if (scope is not null)
    {
        <p>@scope.FullName · @scope.ClassDisplay</p>
    }
</div>

@if (scope is not null)
{
    <partial name="Partials/_ParentChildPicker" model="scope" />
}

@if (Model.Count == 0)
{
    <div class="dash-panel reveal"><p class="text-muted mb-0">No published diary entries yet.</p></div>
}
else
{
    <div class="dash-panel reveal">
        @foreach (var item in Model)
        {
            <article class="mb-3 pb-3 border-bottom">
                <div class="d-flex justify-content-between gap-2 flex-wrap">
                    <h4 class="mb-1">@item.Title</h4>
                    <span class="text-muted">@item.ContentDate.ToString("MMM d, yyyy")</span>
                </div>
                <p class="text-muted mb-2">@item.SubjectName</p>
                @if (!string.IsNullOrWhiteSpace(item.Topic))
                {
                    <p><strong>Topic:</strong> @item.Topic</p>
                }
                @if (!string.IsNullOrWhiteSpace(item.Homework))
                {
                    <p><strong>Homework:</strong> @item.Homework</p>
                }
                @if (!string.IsNullOrWhiteSpace(item.Instructions))
                {
                    <p>@item.Instructions</p>
                }
            </article>
        }
    </div>
}
