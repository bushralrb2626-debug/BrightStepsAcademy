@model GuardianChangePasswordVm
@{
    Layout = "_DashboardLayout";
}
<div class="section-head reveal mb-2">
    <h2>Change password</h2>
    <p>Set a new password for your guardian portal account.</p>
</div>

<div class="dash-panel reveal" style="max-width:480px;">
    <form method="post" asp-action="ChangePassword">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All"></div>
        <div class="mg-field mb-1">
            <label asp-for="CurrentPassword">Current password</label>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
        </div>
        <div class="mg-field mb-1">
            <label asp-for="NewPassword">New password</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
        </div>
        <div class="mg-field mb-2">
            <label asp-for="ConfirmPassword">Confirm new password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
        </div>
        <button type="submit" class="btn-bsa btn-bsa-primary">Update password</button>
    </form>
</div>
