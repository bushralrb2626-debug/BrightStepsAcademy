@model List<ExplorerBuildingVm>
@{
    ViewData["Title"] = "Infrastructure Explorer";
}
<h1 class="mg-page-title">Infrastructure explorer</h1>
<p class="mg-page-sub">Buildings → floors → rooms</p>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>Nothing to explore</h3><p>Add buildings to see the tree.</p></div></div>
}
else
{
    <div class="mg-card mg-tree">
        @foreach (var b in Model)
        {
            <details open>
                <summary>@b.Name <span class="mg-badge @(b.IsActive ? "mg-badge-ok" : "mg-badge-off")">@(b.IsActive ? "Active" : "Off")</span></summary>
                @foreach (var f in b.Floors)
                {
                    <details open>
                        <summary>Floor @f.FloorNumber @(f.FloorName != null ? "— " + f.FloorName : "")</summary>
                        @if (f.Rooms.Count == 0)
                        {
                            <div class="room-leaf">No rooms</div>
                        }
                        else
                        {
                            foreach (var r in f.Rooms)
                            {
                                <div class="room-leaf">
                                    <a href="/Manage/School/Rooms/Details/@r.Id">@r.RoomNumber @(r.RoomName != null ? "— " + r.RoomName : "")</a>
                                    · @r.FurnitureCount furniture
                                </div>
                            }
                        }
                    </details>
                }
            </details>
        }
    </div>
}
