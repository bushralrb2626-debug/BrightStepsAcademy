@model StudentFormVm
@{
    ViewData["Title"] = "Add Student";
}
<h1 class="mg-page-title">Add student</h1>
<p class="mg-page-sub"><a href="/Manage/School/Students">← Students</a></p>
<div class="mg-card">
<form method="post" class="mg-form wide">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>

    <section class="mg-form-section">
        <h2 class="mg-form-section__title">Student information</h2>
        <div class="mg-grid-2">
            <div class="mg-field"><label>Student code</label><input asp-for="StudentCode" required /></div>
            <div class="mg-field"><label>Full name</label><input asp-for="FullName" required /></div>
            <div class="mg-field"><label>Email</label><input asp-for="Email" type="email" /></div>
            <div class="mg-field">
                <label>Gender</label>
                <select asp-for="Gender">
                    <option value="">— Select gender —</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="mg-field"><label>Date of birth</label><input asp-for="DateOfBirth" type="date" /></div>
            <div class="mg-field"><label>Admission date</label><input asp-for="AdmissionDate" type="date" /></div>
            <div class="mg-field"><label>Class</label><select asp-for="SchoolClassId" asp-items="Model.ClassOptions"></select></div>
            <div class="mg-field"><label>Section</label><select asp-for="SchoolSectionId" asp-items="Model.SectionOptions"></select></div>
            <div class="mg-field"><label>Class (legacy text)</label><input asp-for="ClassName" /></div>
            <div class="mg-field"><label>Section (legacy text)</label><input asp-for="Section" /></div>
            <div class="mg-field"><label>Roll number</label><input asp-for="RollNumber" /></div>
            <div class="mg-field"><label>Emergency contact</label><input asp-for="EmergencyContact" /></div>
        </div>
        <div class="mg-field"><label>Address</label><textarea asp-for="Address"></textarea></div>
    </section>

    <partial name="_GuardianFields" model="Model" />
    <partial name="_StudentPortalFields" model="Model" />

    <button type="submit" class="mg-btn mg-btn-primary">Create student</button>
</form>
</div>
