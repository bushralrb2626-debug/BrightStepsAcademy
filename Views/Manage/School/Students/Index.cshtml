@model List<StudentRecord>
@{
    ViewData["Title"] = "Students";
}
<div class="mg-toolbar">
    <div>
        <h1 class="mg-page-title">Students</h1>
        <p class="mg-page-sub">Enrollment records</p>
    </div>
    <a class="mg-btn mg-btn-primary" href="/Manage/School/Students/Create">Add student</a>
</div>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No students yet</h3><p>Add your first student record.</p><a class="mg-btn mg-btn-primary" href="/Manage/School/Students/Create">Add student</a></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Code</th><th>Name</th><th>Class</th><th>Section</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.StudentCode</td>
                    <td>@s.FullName</td>
                    <td>@(s.ClassName ?? "—")</td>
                    <td>@(s.Section ?? "—")</td>
                    <td><span class="mg-badge @(s.IsActive ? "mg-badge-ok" : "mg-badge-off")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                        <a class="mg-btn mg-btn-sm mg-btn-secondary" href="/Manage/School/Students/Edit/@s.Id">Edit</a>
                        @if (s.IsActive)
                        {
                            <form method="post" action="/Manage/School/Students/Deactivate/@s.Id" style="display:inline;" onsubmit="return confirm('Deactivate this student?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="mg-btn mg-btn-sm mg-btn-danger">Deactivate</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
