@using BrightStepsAcademy.Domain
@model List<BrightStepsAcademy.Models.Manage.FeeVoucherListVm>
@{
    ViewData["Title"] = "Fee Vouchers";
    var status = ViewBag.Status as FeeVoucherStatus?;
    string StatusBadge(FeeVoucherStatus s) => s switch
    {
        FeeVoucherStatus.Paid => "mg-badge-ok",
        FeeVoucherStatus.Overdue => "mg-badge-school-suspended",
        FeeVoucherStatus.Cancelled => "mg-badge-off",
        _ => "mg-badge-school-pending"
    };
}
<div class="mg-toolbar">
    <div>
        <h1 class="mg-page-title">Fee vouchers</h1>
        <p class="mg-page-sub"><a href="/Manage/School/Fees">← Fee management</a></p>
    </div>
    <a class="mg-btn mg-btn-primary" href="/Manage/School/Fees/Vouchers/Create">Create voucher</a>
</div>

<div class="mg-card" style="margin-bottom:1rem;">
    <form method="get" class="mg-form" style="display:flex;gap:0.75rem;align-items:flex-end;">
        <div class="mg-field" style="margin:0;">
            <label>Status</label>
            <select name="status">
                <option value="">All</option>
                @foreach (FeeVoucherStatus s in Enum.GetValues<FeeVoucherStatus>())
                {
                    <option value="@((int)s)" selected="@(status == s ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <button type="submit" class="mg-btn mg-btn-secondary">Filter</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No vouchers</h3><p>Create fee vouchers for students.</p><a class="mg-btn mg-btn-primary" href="/Manage/School/Fees/Vouchers/Create">Create voucher</a></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead>
                <tr>
                    <th>Voucher #</th>
                    <th>Student</th>
                    <th>Title</th>
                    <th>Total</th>
                    <th>Paid</th>
                    <th>Due</th>
                    <th>Status</th>
                    <th>Sent</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var v in Model)
            {
                var balance = v.TotalAmount - v.PaidAmount;
                <tr>
                    <td>@v.VoucherNumber</td>
                    <td>@v.StudentName</td>
                    <td>@v.Title</td>
                    <td>@v.TotalAmount.ToString("N2")</td>
                    <td>@v.PaidAmount.ToString("N2")</td>
                    <td>@v.DueDate.ToString("dd MMM yyyy")</td>
                    <td><span class="mg-badge @StatusBadge(v.Status)">@v.Status</span></td>
                    <td>@(v.SentToGuardian ? "Yes" : "No")</td>
                    <td>
                        @if (balance > 0 && v.Status != FeeVoucherStatus.Cancelled)
                        {
                            <a class="mg-btn mg-btn-sm mg-btn-primary" href="/Manage/School/Fees/Vouchers/Pay/@v.Id">Record payment</a>
                        }
                        @if (!v.SentToGuardian && v.Status != FeeVoucherStatus.Cancelled)
                        {
                            <form method="post" action="/Manage/School/Fees/Vouchers/Send/@v.Id" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="mg-btn mg-btn-sm mg-btn-secondary">Mark sent</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
