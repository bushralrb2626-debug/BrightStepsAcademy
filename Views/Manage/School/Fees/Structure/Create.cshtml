@model BrightStepsAcademy.Models.Manage.FeeStructureFormVm
@{
    ViewData["Title"] = "Add Fee Item";
}
<h1 class="mg-page-title">Add fee item</h1>
<p class="mg-page-sub"><a href="/Manage/School/Fees/Structure">← Fee structure</a></p>
<div class="mg-card">
<form method="post" class="mg-form wide">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <div class="mg-grid-2">
        <div class="mg-field"><label>Name</label><input asp-for="Name" required /></div>
        <div class="mg-field"><label>Amount</label><input asp-for="Amount" type="number" step="0.01" min="0" required /></div>
        <div class="mg-field"><label>Class (optional)</label><select asp-for="SchoolClassId" asp-items="Model.ClassOptions"></select></div>
        <div class="mg-field"><label>Billing frequency</label><input asp-for="BillingFrequency" placeholder="e.g. Monthly, Annual" /></div>
        <div class="mg-field" style="grid-column:1/-1;">
            <label>Description</label>
            <textarea asp-for="Description"></textarea>
        </div>
        <div class="mg-field">
            <label><input asp-for="IsActive" type="checkbox" /> Active</label>
        </div>
    </div>
    <button type="submit" class="mg-btn mg-btn-primary">Add fee item</button>
</form>
</div>
