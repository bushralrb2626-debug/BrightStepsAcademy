@model List<StaffCategory>
@{
    ViewData["Title"] = "Staff Categories";
}
<div class="mg-toolbar">
    <div>
        <h1 class="mg-page-title">Staff categories</h1>
        <p class="mg-page-sub">Teachers, helpers, and more</p>
    </div>
</div>

<div class="mg-card" style="margin-bottom:1rem;">
    <h3 style="margin-top:0;font-size:1rem;">Add category</h3>
    <form method="post" action="/Manage/School/Staff/Categories/Create" class="mg-form">
        @Html.AntiForgeryToken()
        <div class="mg-grid-2">
            <div class="mg-field"><label>Name</label><input name="Name" required /></div>
            <div class="mg-field"><label>Description</label><input name="Description" /></div>
        </div>
        <button type="submit" class="mg-btn mg-btn-primary">Add</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No categories yet</h3><p>Create categories before adding staff.</p></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Name</th><th>Description</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>
                        <form method="post" action="/Manage/School/Staff/Categories/Edit/@c.Id">
                            @Html.AntiForgeryToken()
                            <input name="Name" value="@c.Name" />
                            <input name="Description" value="@c.Description" style="margin-top:0.35rem;" />
                            <button type="submit" class="mg-btn mg-btn-sm mg-btn-secondary" style="margin-top:0.35rem;">Save</button>
                        </form>
                    </td>
                    <td>@(c.Description ?? "—")</td>
                    <td><span class="mg-badge @(c.IsActive ? "mg-badge-ok" : "mg-badge-off")">@(c.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                        @if (c.IsActive)
                        {
                            <form method="post" action="/Manage/School/Staff/Categories/Deactivate/@c.Id" onsubmit="return confirm('Deactivate this category?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="mg-btn mg-btn-sm mg-btn-danger">Deactivate</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
