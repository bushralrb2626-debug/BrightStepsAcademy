@model List<CampusVisit>
@{
    ViewData["Title"] = "Campus visits";
}

<div class="mg-toolbar">
    <div>
        <h1 class="mg-page-title">Campus visits</h1>
        <p class="mg-page-sub">Meetings booked by signed-in families through the campus chat.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No visits yet</h3><p>When a logged-in parent books a visit in the chatbot, it appears here.</p></div></div>
}
else
{
    <div class="mg-card">
        <table class="mg-table">
            <thead>
                <tr>
                    <th>Requested</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Visit time</th>
                    <th>Child / year</th>
                    <th>Language</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var v in Model)
            {
                <tr>
                    <td>@v.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@v.Name</td>
                    <td>@v.Email</td>
                    <td>@v.WhenText</td>
                    <td>@v.ChildAge</td>
                    <td>@v.Language</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
