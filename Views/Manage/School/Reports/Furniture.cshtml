@model List<FurnitureItem>
@{
    ViewData["Title"] = "Furniture Report";
}
<h1 class="mg-page-title">Furniture report</h1>
<p class="mg-page-sub"><a href="/Manage/School/Reports">← Overview</a></p>
@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No furniture</h3><p>Nothing to report yet.</p></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Name</th><th>Room</th><th>Category</th><th>Qty</th><th>Condition</th><th>Active</th></tr></thead>
            <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td>@f.Name</td>
                    <td>@f.Room?.RoomNumber</td>
                    <td>@f.Category</td>
                    <td>@f.Quantity</td>
                    <td>@f.Condition</td>
                    <td>@(f.IsActive ? "Yes" : "No")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
