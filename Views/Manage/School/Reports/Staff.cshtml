@model List<StaffMember>
@{
    ViewData["Title"] = "Staff Report";
}
<h1 class="mg-page-title">Staff report</h1>
<p class="mg-page-sub"><a href="/Manage/School/Reports">← Overview</a></p>
@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No staff</h3><p>Nothing to report yet.</p></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Code</th><th>Name</th><th>Category</th><th>Designation</th><th>Login</th><th>Active</th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.StaffCode</td>
                    <td>@s.FullName</td>
                    <td>@s.StaffCategory?.Name</td>
                    <td>@(s.Designation ?? "—")</td>
                    <td>@(s.HasLoginAccess ? "Yes" : "No")</td>
                    <td>@(s.IsActive ? "Yes" : "No")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
