@model List<StudentRecord>
@{
    ViewData["Title"] = "Students Report";
}
<h1 class="mg-page-title">Students report</h1>
<p class="mg-page-sub"><a href="/Manage/School/Reports">← Overview</a></p>
@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No students</h3><p>Nothing to report yet.</p></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Code</th><th>Name</th><th>Class</th><th>Section</th><th>Roll</th><th>Active</th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.StudentCode</td>
                    <td>@s.FullName</td>
                    <td>@(s.ClassName ?? "—")</td>
                    <td>@(s.Section ?? "—")</td>
                    <td>@(s.RollNumber ?? "—")</td>
                    <td>@(s.IsActive ? "Yes" : "No")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
