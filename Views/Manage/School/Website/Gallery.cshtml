@model List<BrightStepsAcademy.Domain.GalleryItem>
@{
    ViewData["Title"] = "Gallery";
}
<h1 class="mg-page-title">Gallery</h1>
<p class="mg-page-sub"><a href="/Manage/School/Website">← Website</a></p>

<div class="mg-card" style="margin-bottom:1rem;">
    <h3 style="margin-top:0;font-size:1rem;">Add gallery item</h3>
    <form method="post" action="/Manage/School/Website/Gallery/Create" enctype="multipart/form-data" class="mg-form">
        @Html.AntiForgeryToken()
        <div class="mg-grid-2">
            <div class="mg-field"><label>Title</label><input name="Title" /></div>
            <div class="mg-field"><label>Category</label><input name="Category" /></div>
            <div class="mg-field"><label>Display order</label><input name="DisplayOrder" type="number" value="0" /></div>
            <div class="mg-field"><label class="mg-check"><input type="checkbox" name="IsFeatured" value="true" /> Featured</label></div>
        </div>
        <div class="mg-field"><label>Description</label><textarea name="Description"></textarea></div>
        <div class="mg-field"><label>Image *</label><input type="file" name="imageFile" accept="image/*" required /></div>
        <button type="submit" class="mg-btn mg-btn-primary">Add</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>Gallery is empty</h3><p>Upload your first image above.</p></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Preview</th><th>Title</th><th>Category</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var g in Model)
            {
                <tr>
                    <td><img src="@g.ImagePath" class="mg-thumb" alt="" /></td>
                    <td>@(g.Title ?? "—")</td>
                    <td>@(g.Category ?? "—")</td>
                    <td><span class="mg-badge @(g.IsActive ? "mg-badge-ok" : "mg-badge-off")">@(g.IsActive ? "Active" : "Off")</span></td>
                    <td>
                        <form method="post" action="/Manage/School/Website/Gallery/Delete/@g.Id" onsubmit="return confirm('Deactivate this gallery item?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="mg-btn mg-btn-sm mg-btn-danger">Deactivate</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
