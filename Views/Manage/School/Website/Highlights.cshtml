@model List<HighlightItem>
@{
    ViewData["Title"] = "Highlights";
}
<h1 class="mg-page-title">Highlights</h1>
<p class="mg-page-sub"><a href="/Manage/School/Website">← Website</a></p>

<div class="mg-card" style="margin-bottom:1rem;">
    <h3 style="margin-top:0;font-size:1rem;">Add highlight</h3>
    <form method="post" action="/Manage/School/Website/Highlights/Create" class="mg-form">
        @Html.AntiForgeryToken()
        <div class="mg-grid-2">
            <div class="mg-field"><label>Title</label><input name="Title" required /></div>
            <div class="mg-field"><label>Display order</label><input name="DisplayOrder" type="number" value="0" /></div>
        </div>
        <div class="mg-field"><label>Description</label><textarea name="Description"></textarea></div>
        <div class="mg-field"><label>Image or icon URL</label><input name="ImageOrIcon" /></div>
        <button type="submit" class="mg-btn mg-btn-primary">Add</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No highlights yet</h3><p>Add your first highlight above.</p></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Title</th><th>Order</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td>
                        <form method="post" action="/Manage/School/Website/Highlights/Edit/@h.Id" class="mg-form" style="max-width:none;gap:0.4rem;">
                            @Html.AntiForgeryToken()
                            <input name="Title" value="@h.Title" />
                            <input name="Description" value="@h.Description" />
                            <input name="ImageOrIcon" value="@h.ImageOrIcon" />
                            <input name="DisplayOrder" type="number" value="@h.DisplayOrder" style="width:80px;display:inline-block;" />
                            <label class="mg-check"><input type="checkbox" name="IsActive" value="true" @(h.IsActive ? "checked" : null) /> Active</label>
                            <button type="submit" class="mg-btn mg-btn-sm mg-btn-secondary">Save</button>
                        </form>
                    </td>
                    <td>@h.DisplayOrder</td>
                    <td><span class="mg-badge @(h.IsActive ? "mg-badge-ok" : "mg-badge-off")">@(h.IsActive ? "Active" : "Off")</span></td>
                    <td>
                        <form method="post" action="/Manage/School/Website/Highlights/Delete/@h.Id" onsubmit="return confirm('Deactivate this highlight?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="mg-btn mg-btn-sm mg-btn-danger">Deactivate</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
