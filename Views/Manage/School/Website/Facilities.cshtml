@model List<FacilityItem>
@{
    ViewData["Title"] = "Facilities";
}
<h1 class="mg-page-title">Facilities</h1>
<p class="mg-page-sub"><a href="/Manage/School/Website">← Website</a></p>

<div class="mg-card" style="margin-bottom:1rem;">
    <h3 style="margin-top:0;font-size:1rem;">Add facility</h3>
    <form method="post" action="/Manage/School/Website/Facilities/Create" enctype="multipart/form-data" class="mg-form">
        @Html.AntiForgeryToken()
        <div class="mg-grid-2">
            <div class="mg-field"><label>Name</label><input name="Name" required /></div>
            <div class="mg-field"><label>Display order</label><input name="DisplayOrder" type="number" value="0" /></div>
        </div>
        <div class="mg-field"><label>Description</label><textarea name="Description"></textarea></div>
        <div class="mg-field"><label>Image</label><input type="file" name="imageFile" accept="image/*" /></div>
        <button type="submit" class="mg-btn mg-btn-primary">Add</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No facilities yet</h3><p>Add your first facility above.</p></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Name</th><th>Order</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td>
                        <strong>@f.Name</strong>
                        @if (!string.IsNullOrEmpty(f.ImagePath)) { <div><img src="@f.ImagePath" class="mg-thumb" alt="" /></div> }
                        <form method="post" action="/Manage/School/Website/Facilities/Edit/@f.Id" enctype="multipart/form-data" style="margin-top:0.5rem;">
                            @Html.AntiForgeryToken()
                            <input name="Name" value="@f.Name" />
                            <input name="Description" value="@f.Description" />
                            <input name="DisplayOrder" type="number" value="@f.DisplayOrder" />
                            <label class="mg-check"><input type="checkbox" name="IsActive" value="true" @(f.IsActive ? "checked" : null) /> Active</label>
                            <input type="file" name="imageFile" accept="image/*" />
                            <button type="submit" class="mg-btn mg-btn-sm mg-btn-secondary">Save</button>
                        </form>
                    </td>
                    <td>@f.DisplayOrder</td>
                    <td><span class="mg-badge @(f.IsActive ? "mg-badge-ok" : "mg-badge-off")">@(f.IsActive ? "Active" : "Off")</span></td>
                    <td>
                        <form method="post" action="/Manage/School/Website/Facilities/Delete/@f.Id" onsubmit="return confirm('Deactivate this facility?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="mg-btn mg-btn-sm mg-btn-danger">Deactivate</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
