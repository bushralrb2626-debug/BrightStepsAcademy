@model FurnitureFormVm
@{
    ViewData["Title"] = "Add Furniture";
    var hasRooms = Model.RoomOptions.Count > 1;
}
<h1 class="mg-page-title">Add furniture</h1>
<p class="mg-page-sub"><a href="/Manage/School/Furniture">← Furniture</a> · Same name in a room merges quantity</p>

@if (!hasRooms)
{
    <div class="mg-card" style="margin-bottom:1rem;">
        <div class="mg-empty">
            <h3>No rooms yet</h3>
            <p>Furniture kisi room mein add hota hai. Pehle infrastructure setup karein:</p>
            <div class="mg-actions" style="margin-top:0.75rem;">
                <a class="mg-btn mg-btn-secondary" href="/Manage/School/Buildings/Create">Add building</a>
                <a class="mg-btn mg-btn-secondary" href="/Manage/School/Floors/Create">Add floor</a>
                <a class="mg-btn mg-btn-primary" href="/Manage/School/Rooms/Create">Add room</a>
            </div>
        </div>
    </div>
}

<div class="mg-card">
<form method="post" action="/Manage/School/Furniture/Create" class="mg-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <div class="mg-field">
        <label>Room</label>
        @if (hasRooms)
        {
            <select asp-for="RoomId" asp-items="Model.RoomOptions" required></select>
        }
        else
        {
            <select asp-for="RoomId" asp-items="Model.RoomOptions" disabled></select>
        }
    </div>
    @if (hasRooms)
    {
        <div class="mg-grid-2">
            <div class="mg-field"><label>Name</label><input asp-for="Name" required /></div>
            <div class="mg-field"><label>Category</label><input asp-for="Category" /></div>
            <div class="mg-field"><label>Quantity</label><input asp-for="Quantity" type="number" min="1" /></div>
            <div class="mg-field"><label>Condition</label><select asp-for="Condition" asp-items="Html.GetEnumSelectList<FurnitureCondition>()"></select></div>
            <div class="mg-field"><label>Purchase date</label><input asp-for="PurchaseDate" type="date" /></div>
        </div>
        <div class="mg-field"><label>Description</label><textarea asp-for="Description"></textarea></div>
        <button type="submit" class="mg-btn mg-btn-primary">Save</button>
    }
</form>
</div>
