@model List<FurnitureItem>
@{
    ViewData["Title"] = "Furniture";
}
<div class="mg-toolbar">
    <div>
        <h1 class="mg-page-title">Furniture</h1>
        <p class="mg-page-sub">Inventory across rooms</p>
    </div>
    <a class="mg-btn mg-btn-primary" href="/Manage/School/Furniture/Create">Add furniture</a>
</div>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No furniture yet</h3><p>Add items to rooms.</p><a class="mg-btn mg-btn-primary" href="/Manage/School/Furniture/Create">Add furniture</a></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>Name</th><th>Room</th><th>Category</th><th>Qty</th><th>Condition</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td>@f.Name</td>
                    <td>@f.Room?.RoomNumber</td>
                    <td>@f.Category</td>
                    <td>@f.Quantity</td>
                    <td>@f.Condition</td>
                    <td><span class="mg-badge @(f.IsActive ? "mg-badge-ok" : "mg-badge-off")">@(f.IsActive ? "Active" : "Inactive")</span></td>
                    <td>
                        <a class="mg-btn mg-btn-sm mg-btn-secondary" href="/Manage/School/Furniture/Edit/@f.Id">Edit</a>
                        @if (f.IsActive)
                        {
                            <form method="post" action="/Manage/School/Furniture/Deactivate/@f.Id" style="display:inline;" onsubmit="return confirm('Deactivate this furniture item?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="mg-btn mg-btn-sm mg-btn-danger">Deactivate</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
