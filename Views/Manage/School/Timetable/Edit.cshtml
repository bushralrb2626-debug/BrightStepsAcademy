@model BrightStepsAcademy.Models.Manage.TimetableSlotFormVm
@using BrightStepsAcademy.Domain
@{
    ViewData["Title"] = "Edit Timetable Slot";
}
<h1 class="mg-page-title">Edit timetable slot</h1>
<p class="mg-page-sub"><a href="/Manage/School/Timetable">← Timetable</a></p>
<div class="mg-card">
<form method="post" action="/Manage/School/Timetable/Edit/@Model.Id" class="mg-form wide">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <div class="mg-grid-2">
        <div class="mg-field"><label>Class</label><select asp-for="SchoolClassId" asp-items="Model.ClassOptions" id="SchoolClassId" required></select></div>
        <div class="mg-field"><label>Section</label><select asp-for="SchoolSectionId" asp-items="Model.SectionOptions" id="SchoolSectionId" required></select></div>
        <div class="mg-field">
            <label>Day</label>
            <select asp-for="DayOfWeek">
                @foreach (DayOfWeek d in Enum.GetValues<DayOfWeek>())
                {
                    <option value="@d">@d</option>
                }
            </select>
        </div>
        <div class="mg-field"><label>Period order</label><input asp-for="PeriodOrder" type="number" min="1" /></div>
        <div class="mg-field"><label>Period label</label><input asp-for="PeriodLabel" /></div>
        <div class="mg-field"><label>Subject</label><select asp-for="SubjectId" asp-items="Model.SubjectOptions" required></select></div>
        <div class="mg-field"><label>Start time</label><input asp-for="StartTime" type="time" step="60" /></div>
        <div class="mg-field"><label>End time</label><input asp-for="EndTime" type="time" step="60" /></div>
        <div class="mg-field"><label>Teacher</label><select asp-for="StaffMemberId" asp-items="Model.TeacherOptions" id="StaffMemberId"></select></div>
        <div class="mg-field"><label>Room</label><select asp-for="RoomId" asp-items="Model.RoomOptions" id="RoomId"></select></div>
        <div class="mg-field">
            <label>Status</label>
            <select asp-for="Status">
                @foreach (PublishStatus s in Enum.GetValues<PublishStatus>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
    </div>
    <button type="submit" class="mg-btn mg-btn-primary">Save changes</button>
</form>
</div>
@section Scripts {
<partial name="Timetable/_TimetableFormScripts" />
}
