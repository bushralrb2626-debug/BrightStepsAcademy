@model List<AuditLog>
@{
    ViewData["Title"] = "Activity";
}
<h1 class="mg-page-title">Activity / audit log</h1>
<p class="mg-page-sub">Recent actions for this school</p>

@if (Model.Count == 0)
{
    <div class="mg-card"><div class="mg-empty"><h3>No activity yet</h3><p>Actions you take in the portal will appear here.</p></div></div>
}
else
{
    <div class="mg-card mg-table-wrap">
        <table class="mg-table">
            <thead><tr><th>When</th><th>User</th><th>Action</th><th>Module</th><th>Record</th><th>Details</th></tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Timestamp.ToLocalTime().ToString("g")</td>
                    <td>@(a.UserName ?? a.UserId)</td>
                    <td>@a.Action</td>
                    <td>@a.Module</td>
                    <td>@(a.RecordType) @(a.RecordId)</td>
                    <td>@(a.Details ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
