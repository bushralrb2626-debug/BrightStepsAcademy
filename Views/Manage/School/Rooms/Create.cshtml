@model RoomFormVm
@{
    ViewData["Title"] = "Create Room";
}
<h1 class="mg-page-title">Add room</h1>
<p class="mg-page-sub"><a href="/Manage/School/Rooms">← Rooms</a></p>
<div class="mg-card">
<form method="post" action="/Manage/School/Rooms/Create" class="mg-form" id="roomForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <div class="mg-field"><label>Building</label><select asp-for="BuildingId" asp-items="ViewBag.Buildings as SelectList" id="BuildingId" required><option value="">Select…</option></select></div>
    <div class="mg-field"><label>Floor</label><select asp-for="FloorId" asp-items="ViewBag.Floors as SelectList" id="FloorId" required><option value="">Select…</option></select></div>
    <div class="mg-grid-2">
        <div class="mg-field"><label>Room number</label><input asp-for="RoomNumber" required /></div>
        <div class="mg-field"><label>Room name</label><input asp-for="RoomName" /></div>
        <div class="mg-field"><label>Type</label><select asp-for="RoomType" asp-items="ViewBag.RoomTypes as SelectList"></select></div>
        <div class="mg-field"><label>Capacity</label><input asp-for="Capacity" type="number" /></div>
    </div>
    <div class="mg-field"><label>Description</label><textarea asp-for="Description"></textarea></div>

    <partial name="_RoomClassSectionFields" model="Model" />

    <button type="submit" class="mg-btn mg-btn-primary">Create</button>
</form>
</div>
<partial name="_RoomQuickAcademic" model="Model" />
@section Scripts {
    <partial name="_RoomFormScripts" />
}
