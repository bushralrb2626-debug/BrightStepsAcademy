@model Floor
@{
    ViewData["Title"] = "Edit Floor";
}
<h1 class="mg-page-title">Edit floor</h1>
<p class="mg-page-sub"><a href="/Manage/School/Floors">← Floors</a></p>
<div class="mg-card">
<form method="post" class="mg-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <div class="mg-field"><label>Building</label><select asp-for="BuildingId" asp-items="ViewBag.Buildings" required></select></div>
    <div class="mg-field"><label>Floor number</label><input asp-for="FloorNumber" type="number" required /></div>
    <div class="mg-field"><label>Floor name</label><input asp-for="FloorName" /></div>
    <div class="mg-field"><label>Description</label><textarea asp-for="Description"></textarea></div>
    <button type="submit" class="mg-btn mg-btn-primary">Save</button>
</form>
</div>
