@{
    ViewData["Title"] = "Academic Setup";
    var needsAssignments = (int)ViewBag.AssignmentCount == 0;
}
<div class="manage-head">
    <h1>Academic setup</h1>
    <p class="text-muted">Classes, sections, subjects, and teacher assignments. Teachers need an assignment before they can add diary notes, attendance, or grade book entries.</p>
</div>

@if (needsAssignments)
{
    <div class="alert alert-info">
        <strong>Next step:</strong> Create a <a asp-action="Assignments">teacher assignment</a> linking each teacher to a class, section, and subject.
        Default classes and subjects are created automatically when you open this page.
    </div>
}

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5>Classes</h5>
                <p class="display-6">@ViewBag.ClassCount</p>
                <a asp-action="Classes" class="btn btn-primary btn-sm">Manage classes</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5>Subjects</h5>
                <p class="display-6">@ViewBag.SubjectCount</p>
                <a asp-action="Subjects" class="btn btn-primary btn-sm">Manage subjects</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5>Teacher assignments</h5>
                <p class="display-6">@ViewBag.AssignmentCount</p>
                <a asp-action="Assignments" class="btn btn-primary btn-sm">Manage assignments</a>
                @if (needsAssignments)
                {
                    <a asp-action="CreateAssignment" class="btn btn-outline-primary btn-sm ms-1">Add assignment</a>
                }
            </div>
        </div>
    </div>
</div>

<ul class="mt-4">
    <li><a asp-action="Sections">Sections</a></li>
</ul>
