@model IEnumerable<BrightStepsAcademy.Domain.SchoolSection>
@{
    ViewData["Title"] = "Sections";
}
<div class="manage-head d-flex justify-content-between align-items-center">
    <h1>Sections</h1>
    <a asp-action="CreateSection" class="btn btn-primary">Add section</a>
</div>

<form method="get" class="mb-3">
    <select name="classId" asp-items="ViewBag.Classes" class="form-select" onchange="this.form.submit()">
        <option value="">All classes</option>
    </select>
</form>

<table class="table">
    <thead><tr><th>Section</th><th>Class ID</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.SchoolClassId</td>
        </tr>
    }
    </tbody>
</table>
