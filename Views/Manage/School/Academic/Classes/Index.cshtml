@model IEnumerable<BrightStepsAcademy.Domain.SchoolClass>
@{
    ViewData["Title"] = "Classes";
}
<div class="manage-head d-flex justify-content-between align-items-center">
    <h1>Classes</h1>
    <a asp-action="CreateClass" class="btn btn-primary">Add class</a>
</div>

<table class="table">
    <thead><tr><th>Name</th><th>Grade</th><th>Order</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.GradeLevel</td>
            <td>@item.DisplayOrder</td>
            <td><a asp-action="EditClass" asp-route-id="@item.Id">Edit</a></td>
        </tr>
    }
    </tbody>
</table>
