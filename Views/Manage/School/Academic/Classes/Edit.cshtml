@model BrightStepsAcademy.Models.Manage.SchoolClassFormVm
@{
    ViewData["Title"] = "Edit Class";
}
<h1>Edit class</h1>
<form asp-action="EditClass" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="GradeLevel" class="form-label"></label>
        <input asp-for="GradeLevel" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" class="form-control" type="number" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Classes" class="btn btn-link">Cancel</a>
</form>
