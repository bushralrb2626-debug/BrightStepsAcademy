@model BrightStepsAcademy.Models.Manage.SchoolClassFormVm
@{
    ViewData["Title"] = "Add Class";
}
<h1>Add class</h1>
<form asp-action="CreateClass" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="GradeLevel" class="form-label"></label>
        <input asp-for="GradeLevel" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" class="form-control" type="number" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Classes" class="btn btn-link">Cancel</a>
</form>
