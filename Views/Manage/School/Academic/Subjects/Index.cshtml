@model IEnumerable<BrightStepsAcademy.Domain.Subject>
@{
    ViewData["Title"] = "Subjects";
}
<div class="manage-head d-flex justify-content-between align-items-center">
    <h1>Subjects</h1>
    <a asp-action="CreateSubject" class="btn btn-primary">Add subject</a>
</div>

<table class="table">
    <thead><tr><th>Name</th><th>Code</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.Name</td><td>@item.Code</td></tr>
    }
    </tbody>
</table>
