@model CreateAdminVm
@{
    ViewData["Title"] = "Add Administrator";
}
<h1 class="mg-page-title">Add administrator</h1>
<p class="mg-page-sub"><a href="/Manage/School/Administrators">← Administrators</a></p>
<div class="mg-card">
<form method="post" class="mg-form wide">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>

    <h2 class="mg-section-title">Admin information</h2>
    <div class="mg-grid-2">
        <div class="mg-field"><label>Full name</label><input asp-for="FullName" required /></div>
        <div class="mg-field"><label>Email</label><input asp-for="Email" type="email" required /></div>
        <div class="mg-field"><label>Login ID</label><input asp-for="LoginId" required placeholder="Used to sign in" /></div>
        <div class="mg-field"><label>Initial password</label><input asp-for="Password" type="password" required /></div>
    </div>

    <h2 class="mg-section-title" style="margin-top:1.5rem;">Assign permissions</h2>
    <p class="mg-muted" style="margin-bottom:1rem;">Choose exactly what this administrator can access. Permissions are enforced on the server — hidden menu items alone are not enough to restrict access.</p>

    <partial name="Partials/_PermissionPicker" model="@(new PermissionPickerVm { FieldName = "permissionCodes", SelectedCodes = Model.PermissionCodes })" />

    <button type="submit" class="mg-btn mg-btn-primary" style="margin-top:1.5rem;">Create admin</button>
</form>
</div>
