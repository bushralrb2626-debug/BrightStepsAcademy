@model BrightStepsAcademy.Models.Manage.ChangePasswordVm
@{
    ViewData["Title"] = "Change password";
}

<h1 class="mg-page-title">Change password</h1>
<p class="mg-page-sub">Update your Super Admin password</p>

<form method="post" action="/Manage/SuperAdmin/ChangePassword" class="mg-card mg-form" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="mg-flash mg-flash-error"></div>
    <div class="mg-field"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="field-error"></span></div>
    <div class="mg-field"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="field-error"></span></div>
    <div class="mg-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
    <div class="mg-actions">
        <button type="submit" class="mg-btn mg-btn-primary">Update password</button>
        <a class="mg-btn mg-btn-secondary" href="/Manage/SuperAdmin/Profile">Cancel</a>
    </div>
</form>
