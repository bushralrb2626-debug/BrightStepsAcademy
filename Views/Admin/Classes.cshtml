@{
    Layout = "_DashboardLayout";
    var store = (ISchoolData)ViewBag.Store;
    var accents = new[] { "sky", "mint", "orange", "pink", "purple", "yellow" };
    var i = 0;
}
<div class="section-head reveal mb-2">
    <h2>Classes</h2>
    <p>Rooms full of curious minds — Grade 3 through 5.</p>
</div>

<div class="grid-3 stagger">
    @foreach (var c in store.Classes)
    {
        var accent = accents[i++ % accents.Length];
        <article class="class-card card-lift accent-@accent">
            <h3>@c.Name</h3>
            <p class="text-muted">@c.Teacher · @c.Room</p>
            <div class="info-row"><span>Students</span><strong>@c.Students</strong></div>
            <div class="info-row"><span>Schedule</span><strong>@c.Schedule</strong></div>
            <button type="button" class="btn-bsa btn-bsa-sm btn-bsa-soft mt-1" onclick="showToast('Opening @c.Name','info')">Open class</button>
        </article>
    }
</div>
