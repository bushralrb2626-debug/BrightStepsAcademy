@model IReadOnlyList<StudentPerformanceSubjectVm>
@{
    Layout = "_DashboardLayout";
}
<div class="section-head reveal mb-2"><h2>My Performance</h2></div>

@if (Model.Count == 0)
{
    <div class="dash-panel reveal"><p class="text-muted mb-0">Not enough published marks to show performance yet.</p></div>
}
else
{
    <div class="grid-2 stagger">
        @foreach (var subject in Model)
        {
            <article class="dash-panel reveal">
                <h3>@subject.SubjectName</h3>
                <p class="mb-2">Average: <strong>@subject.AveragePercentage%</strong> (@subject.AssessmentCount assessments)</p>
                <div class="progress" style="height:10px;">
                    <div class="progress-bar" role="progressbar" style="width:@subject.AveragePercentage%"></div>
                </div>
            </article>
        }
    </div>
}
