@model IReadOnlyList<StudentInfoItemVm>
@{
    Layout = "_DashboardLayout";
}
<div class="section-head reveal mb-2"><h2>Important Information</h2></div>

@if (Model.Count == 0)
{
    <div class="dash-panel reveal"><p class="text-muted mb-0">No important information posted yet.</p></div>
}
else
{
    <div class="dash-panel reveal">
        @foreach (var item in Model)
        {
            <article class="mb-3 pb-3 border-bottom">
                <div class="d-flex justify-content-between gap-2 flex-wrap">
                    <h4 class="mb-1">@item.Title</h4>
                    <span class="text-muted">@item.ContentDate.ToString("MMM d, yyyy")</span>
                </div>
                <p class="text-muted mb-2">@item.SubjectName · @item.AuthorName</p>
                @if (!string.IsNullOrWhiteSpace(item.Description))
                {
                    <p class="mb-0">@item.Description</p>
                }
            </article>
        }
    </div>
}
