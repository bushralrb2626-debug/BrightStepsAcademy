@model StudentAttendanceSummaryVm
@using BrightStepsAcademy.Domain
@{
    Layout = "_DashboardLayout";
}
<div class="section-head reveal mb-2"><h2>My Attendance</h2></div>

<div class="grid-3 stagger mb-2">
    <article class="stat-card reveal"><p class="text-muted mb-0">Present</p><h3>@Model.Present</h3></article>
    <article class="stat-card reveal"><p class="text-muted mb-0">Absent</p><h3>@Model.Absent</h3></article>
    <article class="stat-card reveal"><p class="text-muted mb-0">Overall</p><h3>@Model.OverallPercentage%</h3></article>
</div>

<div class="dash-panel reveal mb-2">
    <h3>@Model.MonthLabel</h3>
    <p>Present: @Model.MonthPresent · Absent: @Model.MonthAbsent · Late: @Model.MonthLate</p>
</div>

<div class="dash-panel reveal">
    <h3>Daily history</h3>
    @if (Model.DailyHistory.Count == 0)
    {
        <p class="text-muted mb-0">No attendance records yet.</p>
    }
    else
    {
        foreach (var row in Model.DailyHistory)
        {
            <div class="info-row">
                <div>
                    <strong>@row.SessionDate.ToString("MMM d, yyyy")</strong>
                    <div class="text-muted small">@row.SubjectName</div>
                </div>
                <span class="badge-soft">@row.Status</span>
            </div>
        }
    }
</div>
